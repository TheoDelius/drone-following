import time
import numpy as np


class PIDs:
    def __init__(self, PidVals, target, limit=None):
        self.PidVals = PidVals
        self.target = target
        self.pError = 0
        self.limit = limit
        self.I = 0
        self.pTime = time.perf_counter()


    def updatedV(self, Valx):
        now = time.perf_counter()
        t = now - self.pTime
        if t == 0:
            t = 0.0001

        self.pTime = now

        error = Valx - self.target

        Pv = self.PidVals[0] * error

        self.I += error * t
        Iv = self.PidVals[1] * self.I

        Dv = self.PidVals[2] * (error - self.pError) / t


        result = Pv + Iv + Dv

        if self.limit is not None:
            result = float(np.clip(result, self.limit[0], self.limit[1]))

        self.pError = error


        return result
